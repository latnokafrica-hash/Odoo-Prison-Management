<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Prison Facility Tree / List View -->
        <record id="view_prison_facility_tree" model="ir.ui.view">
            <field name="name">prison.facility.list</field>
            <field name="model">prison.facility</field>
            <field name="arch" type="xml">
                <list string="Penitentiaries &amp; Correctional Facilities" decoration-danger="is_overcrowded">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="facility_type"/>
                    <field name="city"/>
                    <field name="warden_name"/>
                    <field name="capacity"/>
                    <field name="current_occupancy"/>
                    <field name="occupancy_rate" widget="progressbar"/>
                    <field name="is_overcrowded" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Prison Facility Form View -->
        <record id="view_prison_facility_form" model="ir.ui.view">
            <field name="name">prison.facility.form</field>
            <field name="model">prison.facility</field>
            <field name="arch" type="xml">
                <form string="Correctional Facility">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_inmates" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="current_occupancy" string="Inmates" widget="statinfo"/>
                            </button>
                            <button name="action_view_transfers" type="object" class="oe_stat_button" icon="fa-exchange">
                                <span class="o_stat_text">Transfers</span>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="name" string="Facility Name"/>
                            <h1><field name="name" placeholder="e.g. Kamiti Maximum Security"/></h1>
                            <h3><field name="code" placeholder="e.g. KMT-MAX-01"/></h3>
                        </div>

                        <group>
                            <group string="Classification &amp; Location">
                                <field name="facility_type"/>
                                <field name="city"/>
                                <field name="street"/>
                                <field name="country_id"/>
                            </group>
                            <group string="Administration &amp; Capacity">
                                <field name="warden_id"/>
                                <field name="warden_name"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="capacity"/>
                                <field name="occupancy_rate" widget="progressbar"/>
                                <field name="is_overcrowded" invisible="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Inmate Population">
                                <field name="inmate_ids">
                                    <list string="Inmates" decoration-danger="custody_status == 'escaped'" decoration-warning="security_category == 'CAT_A'">
                                        <field name="booking_number"/>
                                        <field name="name"/>
                                        <field name="gender"/>
                                        <field name="custody_status"/>
                                        <field name="security_category"/>
                                        <field name="progressive_stage"/>
                                        <field name="cell_location"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Directives &amp; Security Brief">
                                <field name="notes" placeholder="Enter perimeter protocols, armed response squads, emergency rally points..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Prison Facility Action Window -->
        <record id="action_prison_facility" model="ir.actions.act_window">
            <field name="name">Correctional Facilities Directorate</field>
            <field name="res_model">prison.facility</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Register a new national correctional facility or remand center.</p>
            </field>
        </record>
    </data>
</odoo>
