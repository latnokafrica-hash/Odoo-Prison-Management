<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Human Rights Audit List View -->
        <record id="view_prison_human_rights_audit_tree" model="ir.ui.view">
            <field name="name">prison.human.rights.audit.list</field>
            <field name="model">prison.human.rights.audit</field>
            <field name="arch" type="xml">
                <list string="UN Mandela Rules &amp; Human Rights Inspections" decoration-danger="compliance_status == 'violation'" decoration-warning="compliance_status == 'remedial_required'" decoration-success="compliance_status == 'compliant'">
                    <field name="date"/>
                    <field name="inmate_id"/>
                    <field name="auditor_name"/>
                    <field name="inspection_type"/>
                    <field name="outdoor_hours_per_day"/>
                    <field name="consecutive_solitary_days"/>
                    <field name="compliance_status" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Human Rights Audit Form View -->
        <record id="view_prison_human_rights_audit_form" model="ir.ui.view">
            <field name="name">prison.human.rights.audit.form</field>
            <field name="model">prison.human.rights.audit</field>
            <field name="arch" type="xml">
                <form string="Human Rights Inspection Audit">
                    <sheet>
                        <group>
                            <group string="Audit Mandate &amp; Inmate">
                                <field name="inmate_id"/>
                                <field name="date"/>
                                <field name="auditor_name"/>
                                <field name="inspection_type"/>
                            </group>
                            <group string="UN Nelson Mandela Rules Standard Checks">
                                <field name="outdoor_hours_per_day"/>
                                <field name="consecutive_solitary_days"/>
                                <field name="medical_visits_count"/>
                                <field name="compliance_status"/>
                            </group>
                        </group>
                        <group string="Corrective Findings &amp; Directives">
                            <field name="recommendations" placeholder="Inspector corrective directives..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Human Rights Action Window -->
        <record id="action_prison_human_rights_audit" model="ir.actions.act_window">
            <field name="name">UN Mandela Rules Compliance Audits</field>
            <field name="res_model">prison.human.rights.audit</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
