<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Prison Management Executive Dashboard Action -->
        <record id="action_prison_management_dashboard" model="ir.actions.act_window">
            <field name="name">National Corrections Operations Dashboard</field>
            <field name="res_model">prison.facility</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_group_facility_type': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Welcome to the National Corrections Operations Dashboard.
                </p>
                <p>
                    Monitor live facility occupancy, active court convoy missions, daily meal catering tallies, visitor security checks, and statutory remission audits.
                </p>
            </field>
        </record>
    </data>
</odoo>
